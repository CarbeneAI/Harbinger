# Harbinger Environment Configuration
# Copy to .env and fill in your values

# ── AI Analysis Provider ────────────────────────────────────────────────────
# claude    (default) - ssh to the machine holding a Claude CLI session and run
#                       `claude -p` on the Claude Max subscription. No API key,
#                       no per-token billing.
# ollama              - local Ollama
# anthropic           - paid Anthropic Messages API (legacy tool-use path)
ANALYSIS_PROVIDER=claude

# Claude CLI over SSH (used when ANALYSIS_PROVIDER=claude).
# Required — no default, so a host is never baked into this public repo.
# CLAUDE_CLI_SSH_HOST=user@your-host
# CLAUDE_CLI_BIN=/opt/homebrew/bin/claude
# CLAUDE_CLI_MODEL=claude-sonnet-5
# CLAUDE_CLI_TIMEOUT_MS=900000
#
# The CLI session runs with ALL tools disallowed. Harbinger gathers related
# IOCs and cve-mcp enrichment itself (prefetch.ts) and injects them into the
# prompt, so analysis stays deterministic and the model gets no shell.

# Internal domain suffixes that must NEVER be sent to third-party enrichment
# APIs (VirusTotal, Shodan, AbuseIPDB, URLScan...). RFC1918, loopback,
# link-local, CGNAT, and *.local/.lan/.corp/.internal are always blocked in
# code. Add comma-separated suffixes here for internal names that live on a
# PUBLIC registrable domain (e.g. .home.example.com), which the TLD check
# cannot catch on its own.
# INTERNAL_DOMAIN_SUFFIXES=.home.example.com,.lab.example.net

# Anthropic API key — ONLY needed when ANALYSIS_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Abuse.ch Auth Key (for URLhaus + ThreatFox feeds)
# Register free at https://auth.abuse.ch/
ABUSE_CH_AUTH_KEY=

# Feed poll interval in milliseconds (default: 1 hour)
# POLL_INTERVAL_MS=3600000

# Database path (default: ./harbinger.db)
# DB_PATH=./harbinger.db

# Server port (default: 4001)
# PORT=4001

# Vite dev server port (default: 5174). Override per host if you need a
# different port — manage.sh sources .env to read this.
# CLIENT_PORT=5174

# ── CVE MCP Threat-Intel Enrichment (optional) ──────────────────────────────
# Connects Harbinger's AI analyst to the audited cve-mcp Python server for
# IOC enrichment via NVD, EPSS, KEV, AbuseIPDB, GreyNoise, Shodan, VirusTotal,
# URLScan, MITRE ATT&CK, and crt.sh.
#
# Prerequisite: cve-mcp installed at ~/Dev/cve-mcp-server with .env populated.
# See: https://github.com/mukul975/cve-mcp-server

# Enable cve-mcp integration (default: true; set false to disable enrichment tools)
# CVE_MCP_ENABLED=true

# Path to the cve-mcp Python interpreter (default: $HOME/Dev/cve-mcp-server/.venv/bin/python)
# CVE_MCP_PYTHON=

# Path to the cve-mcp install directory (default: $HOME/Dev/cve-mcp-server)
# CVE_MCP_CWD=
